---
interface Props {
  title: string;
  paragraphs: string[];
  folio: string;
  from: string;
  to: string;
}
const { title, paragraphs, folio, from, to } = Astro.props;
const [first, ...rest] = paragraphs;
---

<section class="story grain" data-surface="gunmetal" aria-labelledby="story-title">
  <p class="folio folio--corner">{folio}</p>
  <div class="story__head">
    <h2 id="story-title" class="story__title" data-split-lines>{title}</h2>
    <div class="story__route" aria-hidden="true" data-reveal>
      <span class="story__stop"><span class="story__dot"></span>{from}</span>
      <span class="story__line"></span>
      <span class="story__stop story__stop--to"><span class="story__dot"></span>{to}</span>
    </div>
  </div>
  <div class="story__body">
    <p class="story__lead" data-reveal>{first}</p>
    {rest.map((p) => <p class="story__p" data-reveal>{p}</p>)}
  </div>
</section>

<style>
  .story {
    position: relative;
    padding: var(--space-2xl) var(--gutter);
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .story__title {
    font-size: var(--step-4);
    letter-spacing: -0.04em;
    max-width: 10ch;
    color: var(--cm-orange);
  }
  .story__head {
    display: grid;
    gap: var(--space-l);
    align-content: start;
  }
  .story__route {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    max-width: 22rem;
  }
  .story__stop {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .story__dot {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 2px var(--cm-turquoise);
  }
  .story__stop--to .story__dot {
    background: var(--cm-orange);
    box-shadow: none;
  }
  .story__line {
    flex: 1;
    min-width: 3rem;
    border-top: 2px dashed color-mix(in oklab, var(--cm-cream) 40%, transparent);
  }
  .story__body {
    display: grid;
    gap: var(--space-m);
  }
  .story__lead {
    font-size: var(--step-2);
    line-height: 1.3;
    letter-spacing: -0.02em;
    max-width: 34ch;
  }
  .story__p {
    font-size: var(--step-1);
    line-height: 1.5;
    color: color-mix(in oklab, var(--cm-cream) 82%, var(--cm-turquoise));
    max-width: 52ch;
  }
  @media (max-width: 860px) {
    .story {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
