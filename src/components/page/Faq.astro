---
import Icon from '../ui/Icon.astro';

interface Props {
  title: string;
  items: { q: string; a: string }[];
}
const { title, items } = Astro.props;
---

<section class="faq grain" data-surface="cream" aria-labelledby="faq-title">
  <h2 id="faq-title" class="faq__title" data-split-lines>{title}</h2>
  <div class="faq__list">
    {items.map((item) => (
      <details class="faq__item" data-reveal>
        <summary class="faq__q">
          <span>{item.q}</span>
          <span class="faq__icon" aria-hidden="true"><Icon name="close" size="1.2rem" /></span>
        </summary>
        <div class="faq__a"><p>{item.a}</p></div>
      </details>
    ))}
  </div>
</section>

<style>
  .faq {
    padding: var(--space-2xl) var(--gutter);
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .faq__title {
    font-size: var(--step-4);
    letter-spacing: -0.04em;
    max-width: 10ch;
  }
  .faq__list {
    border-top: 1.5px solid var(--cm-gunmetal);
  }
  .faq__item {
    border-bottom: 1.5px solid var(--cm-gunmetal);
    interpolate-size: allow-keywords;
  }
  .faq__q {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-m);
    padding: var(--space-m) 0;
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: -0.02em;
    cursor: pointer;
  }
  .faq__q::-webkit-details-marker {
    display: none;
  }
  .faq__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    border-radius: var(--radius-s);
    box-shadow: inset 0 0 0 1.5px currentColor;
    transition:
      background-color var(--dur-s) var(--ease-soft),
      color var(--dur-s) var(--ease-soft);
  }
  .faq__icon :global(svg) {
    rotate: 45deg;
    transition: rotate var(--dur-s) var(--ease-out);
  }
  .faq__item[open] .faq__icon {
    background: var(--cm-gunmetal);
    color: var(--cm-cream);
  }
  .faq__item[open] .faq__icon :global(svg) {
    rotate: 0deg;
  }
  /* Apertura suave donde el navegador permite animar a altura automática */
  .faq__item::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size var(--dur-m) var(--ease-out),
      content-visibility var(--dur-m) allow-discrete;
  }
  .faq__item[open]::details-content {
    block-size: auto;
  }
  .faq__a {
    padding-bottom: var(--space-m);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--cm-ink-soft);
    max-width: 52ch;
  }
  @media (max-width: 860px) {
    .faq {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq__item::details-content {
      transition: none;
    }
  }
</style>
