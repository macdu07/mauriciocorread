---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { projectHref, type getPage, type getProjects, type getServices, type Locale } from '../../i18n';

type Labels = NonNullable<Awaited<ReturnType<typeof getPage>>['servicesPage']>;
interface Props {
  services: Awaited<ReturnType<typeof getServices>>;
  projects: Awaited<ReturnType<typeof getProjects>>;
  labels: Labels;
  locale: Locale;
}
const { services, projects, labels: t, locale } = Astro.props;
const tones = ['orange', 'cream', 'gunmetal'] as const;
const pad = (n: number) => String(n).padStart(2, '0');
---

{services.map((s, i) => {
  const tone = tones[i % tones.length];
  const related = (s.related ?? []).map((slug) => projects.find((p) => p.slug === slug)).filter((p) => !!p);
  return (
    <section class={`svc svc--${tone} grain`} data-surface={tone} id={s.slug} aria-labelledby={`svc-${s.slug}`}>
      <p class="svc__num poster" aria-hidden="true">{pad(i + 1)}</p>
      <div class="svc__grid">
        <div class="svc__main">
          <h2 class="svc__title" id={`svc-${s.slug}`} data-split-lines>{s.title}</h2>
          <p class="svc__desc" data-reveal>{s.description}</p>
          {s.forWho && (
            <div class="svc__for" data-reveal>
              <p class="svc__label">{t.forWho}</p>
              <p>{s.forWho}</p>
            </div>
          )}
        </div>
        <aside class="svc__stub" data-reveal aria-label={t.receives}>
          <div class="svc__stub-body">
            <p class="svc__label">{t.receives}</p>
            <ul role="list" class="svc__list">
              {s.deliverables.map((d) => (
                <li><Icon name="star" size="0.8em" class="svc__star" />{d}</li>
              ))}
            </ul>
          </div>
          <div class="svc__stub-code" aria-hidden="true">
            <Icon name="star" size="1.4rem" class="svc__star" />
            <span>SV/{pad(i + 1)}</span>
          </div>
        </aside>
      </div>

      {related.length > 0 && (
        <div class="svc__related">
          <p class="svc__label">{t.related}</p>
          <ul role="list" class="svc__projects">
            {related.map((p) => (
              <li data-reveal>
                <a class="svc__project" href={projectHref(locale, p!.slug)} data-cursor={p!.title}>
                  <span class="svc__shot">
                    <Image src={p!.cover} alt="" widths={[400, 640]} sizes="(min-width: 861px) 28vw, 90vw" />
                    <span class="svc__plate svc__plate--a" aria-hidden="true"></span>
                    <span class="svc__plate svc__plate--b" aria-hidden="true"></span>
                  </span>
                  <span class="svc__pname poster">{p!.title}</span>
                  <Icon name="arrow-up-right" size="1.3rem" class="svc__go" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>
  );
})}

<style>
  .svc {
    position: relative;
    overflow: clip;
    padding: var(--space-2xl) var(--gutter);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
  }
  .svc__num {
    position: absolute;
    z-index: -1;
    right: -0.04em;
    top: -0.1em;
    font-size: clamp(14rem, 32vw, 36rem);
    line-height: 0.78;
    color: color-mix(in oklab, currentColor 9%, transparent);
  }
  .svc--gunmetal .svc__num {
    color: var(--cm-gunmetal-soft);
  }
  .svc__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: end;
  }
  .svc__main {
    display: grid;
    gap: var(--space-m);
  }
  .svc__title {
    font-size: var(--step-4);
    letter-spacing: -0.04em;
    max-width: 14ch;
  }
  .svc--gunmetal .svc__title {
    color: var(--cm-cream);
  }
  .svc__desc {
    font-size: var(--step-1);
    line-height: 1.45;
    max-width: 40ch;
  }
  .svc__for {
    display: grid;
    gap: var(--space-2xs);
    max-width: 46ch;
    padding-top: var(--space-s);
    border-top: 1.5px solid currentColor;
  }
  .svc__label {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .svc__stub {
    --notch: 0.9rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 5.5rem;
    background: var(--cm-cream);
    color: var(--cm-gunmetal);
    border-radius: var(--radius-m);
    filter: drop-shadow(0 18px 26px rgb(29 39 48 / 0.35));
    rotate: -1.5deg;
    mask:
      radial-gradient(circle var(--notch) at calc(100% - 5.5rem) 0, #0000 98%, #000) top / 100% 51% no-repeat,
      radial-gradient(circle var(--notch) at calc(100% - 5.5rem) 100%, #0000 98%, #000) bottom / 100% 51% no-repeat;
  }
  .svc__stub-body {
    display: grid;
    gap: var(--space-s);
    padding: var(--space-l);
  }
  .svc__stub-code {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.6rem;
    border-left: 2px dashed color-mix(in oklab, currentColor 35%, transparent);
  }
  .svc__stub-code span {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    writing-mode: vertical-rl;
    rotate: 180deg;
  }
  .svc--cream .svc__stub {
    background: var(--cm-gunmetal);
    color: var(--cm-cream);
  }
  .svc__list {
    display: grid;
    gap: 0.7rem;
    font-weight: 600;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }
  .svc__list li {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
  }
  :global(.svc__star) {
    color: var(--cm-orange);
    flex: none;
  }

  .svc__related {
    display: grid;
    gap: var(--space-s);
  }
  .svc__projects {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-m);
  }
  .svc__project {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-xs);
    align-items: end;
    text-decoration: none;
  }
  .svc__shot {
    grid-column: 1 / -1;
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    isolation: isolate;
    border-radius: var(--radius-frame);
    box-shadow: 0 20px 34px -22px rgb(29 39 48 / 0.55);
  }
  .svc__shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    filter: grayscale(1) contrast(1.12);
    transition:
      filter var(--dur-m) var(--ease-soft),
      transform var(--dur-l) var(--ease-out);
  }
  .svc__plate {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: opacity var(--dur-m) var(--ease-soft);
  }
  .svc__plate--a {
    background: var(--cm-orange);
    mix-blend-mode: multiply;
    opacity: 0.8;
  }
  .svc__plate--b {
    background: var(--cm-turquoise-deep);
    mix-blend-mode: screen;
    opacity: 0.6;
  }
  .svc__pname {
    font-size: clamp(2.6rem, 3.4vw, 3.6rem);
    line-height: 0.85;
  }
  .svc--gunmetal .svc__pname {
    color: var(--cm-orange);
  }
  :global(.svc__go) {
    transition: transform var(--dur-s) var(--ease-out);
  }
  @media (hover: hover) {
    .svc__project:hover .svc__shot :global(img) {
      filter: none;
      transform: scale(1.04);
    }
    .svc__project:hover .svc__plate {
      opacity: 0;
    }
    .svc__project:hover :global(.svc__go) {
      transform: rotate(45deg);
    }
  }

  @media (max-width: 860px) {
    .svc__grid,
    .svc__projects {
      grid-template-columns: minmax(0, 1fr);
    }
    .svc__stub {
      rotate: -1deg;
    }
  }
</style>
