---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { projectHref, type getPage, type getProjects, type Locale } from '../../i18n';

type Data = NonNullable<Awaited<ReturnType<typeof getPage>>['archive']>;
interface Props {
  archive: Data;
  projects: Awaited<ReturnType<typeof getProjects>>;
  locale: Locale;
  index: string;
}
const { archive, projects, locale, index } = Astro.props;
const rest = projects.filter((p) => !p.featured);
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="archive grain" data-surface="cream" data-archive aria-labelledby="archive-title">
  <p class="folio folio--corner">{index ? `${index} · ` : ''}{archive.folio}</p>

  <div class="archive__head">
    <h2 id="archive-title" class="archive__title" data-split-lines>{archive.title}</h2>
    <p class="archive__lead" data-reveal>{archive.lead}</p>
  </div>

  <ol class="archive__list" role="list">
    {rest.map((p) => (
      <li class="archive__row" data-reveal>
        <a href={projectHref(locale, p.slug)} class="archive__link" data-archive-row={p.slug} data-cursor={archive.openCase}>
          <span class="archive__num">{pad(p.order)}</span>
          <span class="archive__name poster">{p.title}</span>
          <span class="archive__cat">{p.categories.join(' · ')}{p.credit && <><br />{p.credit}</>}</span>
          <span class="archive__go">
            <span class="visually-hidden">{archive.openCase}</span>
            <Icon name="arrow-up-right" size="1.6rem" />
          </span>
        </a>
      </li>
    ))}
  </ol>

  <a class="archive__all" href={archive.all.href} data-reveal>
    {archive.all.label}
    <Icon name="arrow-up-right" size="1.1em" />
  </a>

  <!-- Imagen que sigue al cursor (solo escritorio con puntero fino) -->
  <div class="archive__float" data-archive-float aria-hidden="true">
    {rest.map((p) => (
      <figure class="archive__shot" data-archive-shot={p.slug}>
        <Image src={p.cover} alt="" widths={[480, 720]} sizes="26vw" />
      </figure>
    ))}
  </div>
</section>

<style>
  .archive {
    padding: var(--space-2xl) var(--gutter);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
  }
  .archive__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-l);
    align-items: end;
  }
  .archive__title {
    font-size: var(--step-4);
    letter-spacing: -0.04em;
  }
  .archive__lead {
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--cm-ink-soft);
    max-width: 34ch;
  }
  .archive__list {
    border-top: 1.5px solid var(--cm-gunmetal);
  }
  .archive__row {
    border-bottom: 1.5px solid var(--cm-gunmetal);
  }
  .archive__link {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) auto 3rem;
    align-items: center;
    gap: var(--space-m);
    padding: clamp(1rem, 2vw, 1.75rem) 0;
    text-decoration: none;
    transition: color var(--dur-s) var(--ease-soft);
  }
  .archive__name {
    transition: transform var(--dur-s) var(--ease-out);
  }
  .archive__num {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    transition: color var(--dur-s) var(--ease-soft);
  }
  .archive__name {
    font-size: clamp(2.6rem, 6.4vw, 6.5rem);
    line-height: 0.86;
  }
  .archive__cat {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cm-ink-soft);
  }
  .archive__go {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-s);
    box-shadow: inset 0 0 0 1.5px currentColor;
    transition:
      background-color var(--dur-s) var(--ease-soft),
      color var(--dur-s) var(--ease-soft),
      transform var(--dur-s) var(--ease-out);
  }
  @media (hover: hover) {
    .archive__link:hover .archive__name {
      transform: translateX(1.25rem);
    }
    .archive__link:hover .archive__num {
      color: var(--cm-orange);
    }
    .archive__link:hover .archive__go {
      background: var(--cm-gunmetal);
      color: var(--cm-cream);
      transform: rotate(45deg);
    }
  }
  .archive__all {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: var(--step-1);
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) left bottom / 100% 1.5px no-repeat;
    padding-bottom: 0.2rem;
    transition: background-size var(--dur-s) var(--ease-out);
  }
  .archive__all:hover {
    background-size: 30% 1.5px;
  }

  .archive__float {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 40;
    width: clamp(16rem, 24vw, 24rem);
    aspect-ratio: 3 / 2;
    pointer-events: none;
    display: none;
    will-change: transform;
  }
  :global(html.has-cursor) .archive__float {
    display: block;
  }
  .archive__shot {
    position: absolute;
    inset: 0;
    margin: 0;
    border-radius: var(--radius-frame);
    overflow: hidden;
    opacity: 0;
    box-shadow: 0 30px 50px -25px rgb(29 39 48 / 0.55);
  }
  .archive__shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 860px) {
    .archive__head {
      grid-template-columns: 1fr;
    }
    .archive__link {
      grid-template-columns: 2.5rem minmax(0, 1fr) 2.75rem;
    }
    .archive__cat {
      grid-column: 2;
      grid-row: 2;
    }
    .archive__go {
      grid-column: 3;
      grid-row: 1 / span 2;
      width: 2.75rem;
      height: 2.75rem;
    }
  }
</style>
