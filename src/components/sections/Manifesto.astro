---
import Icon from '../ui/Icon.astro';
import type { getPage } from '../../i18n';

type Data = NonNullable<Awaited<ReturnType<typeof getPage>>['manifesto']>;
interface Props {
  manifesto: Data;
  index: string;
}
const { manifesto, index } = Astro.props;
const cut = manifesto.statement.lastIndexOf(manifesto.highlight);
const lead = cut > -1 ? manifesto.statement.slice(0, cut) : manifesto.statement;
const accent = cut > -1 ? manifesto.highlight : '';
const words = (text: string) => text.split(' ').filter(Boolean);
---

<section class="manifesto grain" data-surface="gunmetal" data-manifesto aria-labelledby="manifesto-title">
  <p class="manifesto__folio folio folio--corner">{index} · {manifesto.folio}</p>
  <p class="manifesto__ghost poster" aria-hidden="true" data-breathe>{manifesto.folio}</p>
  <span class="mark mark--star-o" aria-hidden="true"><Icon name="star" size="100%" /></span>
  <span class="mark mark--star-t" aria-hidden="true"><Icon name="star" size="100%" /></span>
  <span class="mark mark--reg" aria-hidden="true"></span>

  <h2 class="manifesto__statement" id="manifesto-title" data-scrub-words>
    {words(lead).map((w) => <span class="w">{w} </span>)}
    {words(accent).map((w) => <span class="w w--accent">{w} </span>)}
  </h2>

  <div class="manifesto__aside">
    <svg class="manifesto__orbit" viewBox="0 0 200 200" fill="none" aria-hidden="true" data-orbit>
      <circle cx="100" cy="100" r="96" />
      <circle cx="100" cy="100" r="62" stroke-dasharray="3 7" />
      <circle cx="100" cy="100" r="24" />
      <path d="M100 0v200M0 100h200" />
      <circle class="manifesto__planet" cx="196" cy="100" r="6" />
    </svg>
    <p class="manifesto__body" data-reveal>{manifesto.body}</p>
  </div>
</section>

<style>
  .manifesto {
    overflow: clip;
    min-height: 90svh;
    padding: clamp(5rem, 14svh, 9rem) var(--gutter) var(--space-2xl);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-content: start;
    row-gap: var(--space-xl);
    column-gap: var(--space-m);
  }
  .manifesto__folio {
    color: var(--cm-cream-soft);
  }
  .manifesto__ghost {
    position: absolute;
    z-index: -1;
    right: -0.04em;
    bottom: -0.1em;
    font-size: clamp(8rem, 30vw, 34rem);
    line-height: 0.75;
    color: var(--cm-gunmetal-soft);
    white-space: nowrap;
    pointer-events: none;
  }
  .mark {
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }
  .mark--star-o {
    width: clamp(2.5rem, 5vw, 4.5rem);
    top: 18%;
    right: 12%;
    color: var(--cm-orange);
  }
  .mark--star-t {
    width: clamp(1.4rem, 2.6vw, 2.4rem);
    bottom: 16%;
    left: 6%;
    color: var(--cm-turquoise);
  }
  .mark--reg {
    width: 1.75rem;
    aspect-ratio: 1;
    right: var(--gutter);
    bottom: var(--space-l);
    border-radius: 50%;
    border: 1.2px solid var(--cm-cream-soft);
    background:
      linear-gradient(var(--cm-cream-soft), var(--cm-cream-soft)) center / 160% 1.2px no-repeat,
      linear-gradient(var(--cm-cream-soft), var(--cm-cream-soft)) center / 1.2px 160% no-repeat;
  }
  .manifesto__statement {
    grid-column: 1 / span 11;
    font-size: clamp(2.6rem, 1.4rem + 5.6vw, 7.5rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .w {
    display: inline;
  }
  .w--accent {
    color: var(--cm-orange);
  }
  .manifesto__aside {
    grid-column: 6 / span 7;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-l);
    align-items: center;
  }
  .manifesto__orbit {
    width: clamp(5rem, 9vw, 8.5rem);
    stroke: var(--cm-turquoise);
    stroke-width: 1.3;
  }
  .manifesto__planet {
    fill: var(--cm-orange);
    stroke: none;
  }
  .manifesto__body {
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--cm-cream);
    max-width: 38ch;
  }
  @media (max-width: 860px) {
    .manifesto__statement,
    .manifesto__aside {
      grid-column: 1 / -1;
    }
    .manifesto__aside {
      grid-template-columns: 1fr;
    }
    .manifesto__ghost {
      right: auto;
      left: var(--gutter);
      bottom: 0.35em;
      font-size: 27vw;
    }
  }
</style>
