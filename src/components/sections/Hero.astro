---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Stamp from '../ui/Stamp.astro';
import type { getPage, getSettings } from '../../i18n';

type HeroData = NonNullable<Awaited<ReturnType<typeof getPage>>['hero']>;
interface Props {
  hero: HeroData;
  settings: Awaited<ReturnType<typeof getSettings>>;
}
const { hero, settings } = Astro.props;
const [first, second] = hero.nameLines;
const screenLayout = ['a', 'b', 'c'];
---

<section class="hero grain" data-surface="cream" data-hero id="top">
  <div class="hero__stage" data-hero-stage>
    <div class="hero__field" data-hero-field aria-hidden="true"></div>

    <!-- Nombre-cartel: capa base (gunmetal) -->
    <p class="hero__name poster" data-hero-name aria-hidden="true">
      <span class="hero__line"><span data-split-chars>{first}</span></span>
      <span class="hero__line hero__line--offset"><span data-split-chars>{second}</span></span>
    </p>

    <!-- Ventana M: el collage vive dentro de la M -->
    <div class="hero__window" data-portal>
      <div class="hero__frame" data-portal-inner>
        <span class="hero__sun" data-depth="0.25" aria-hidden="true"></span>
        <svg class="hero__orbits" data-depth="0.12" viewBox="0 0 880 695" fill="none" aria-hidden="true">
          <ellipse cx="560" cy="250" rx="330" ry="120" transform="rotate(-18 560 250)" />
          <ellipse cx="560" cy="250" rx="230" ry="80" transform="rotate(-18 560 250)" />
          <circle cx="235" cy="355" r="5" />
          <path d="M40 620 L840 120" stroke-dasharray="2 9" />
        </svg>
        {hero.screens.map((screen, i) => (
          <figure class={`hero__screen hero__screen--${screenLayout[i] ?? 'a'}`} data-depth={0.35 + i * 0.15}>
            <figcaption class="hero__screen-bar">{screen.name}</figcaption>
            <div class="print" data-print>
              <Image src={screen.image} alt={screen.alt} widths={[480, 800]} sizes="(min-width: 861px) 34vw, 70vw" loading="eager" />
              <span class="print__plate print__plate--a" aria-hidden="true"></span>
              <span class="print__plate print__plate--b" aria-hidden="true"></span>
            </div>
          </figure>
        ))}
      </div>
      <span class="hero__veil" data-portal-veil aria-hidden="true"></span>
    </div>

    <!-- Nombre-cartel: capa invertida (crema) recortada por la M -->
    <p class="hero__name hero__name--inverse poster" data-hero-name-inverse aria-hidden="true">
      <span class="hero__line"><span data-split-chars>{first}</span></span>
      <span class="hero__line hero__line--offset"><span data-split-chars>{second}</span></span>
    </p>

    <!-- Nombre-cartel: capa crema recortada por el campo turquesa -->
    <p class="hero__name hero__name--field poster" data-hero-name-field aria-hidden="true">
      <span class="hero__line"><span data-split-chars>{first}</span></span>
      <span class="hero__line hero__line--offset"><span data-split-chars>{second}</span></span>
    </p>

    <div class="hero__stamp" data-hero-stamp>
      <Stamp text={hero.stamp} size="clamp(6.5rem, 9vw, 9.5rem)" />
    </div>

    <p class="hero__stat" data-hero-meta>
      <strong>{hero.stat.value}</strong>
      <span>{hero.stat.label}</span>
    </p>

    <div class="hero__copy" data-hero-copy>
      <h1 class="hero__title" data-split-lines>
        <span class="visually-hidden">{settings.siteName}, {settings.role}. </span>
        {hero.title}
      </h1>
      <p class="hero__lead" data-reveal>{hero.lead}</p>
      <div class="hero__actions" data-reveal>
        <Button href={hero.primaryCta.href} variant="ink" icon="arrow-down-right">{hero.primaryCta.label}</Button>
        <Button href={hero.secondaryCta.href} variant="orange">{hero.secondaryCta.label}</Button>
      </div>
    </div>

    <p class="hero__hint folio" data-hero-meta>
      {hero.scrollHint}
      <Icon name="arrow-down" size="1.1em" />
    </p>
  </div>
</section>

<style>
  .hero {
    --mw: min(56vw, 112svh);
    --mh: calc(var(--mw) * 695 / 880);
    --mx: calc(100vw - var(--mw) - 2vw);
    --my: max(calc(var(--header-h) + 7rem), calc(100svh - var(--mh) - 3svh));
    --field-x: 59vw;
    --name-top: calc(var(--header-h) + 1.25rem);
    --name-offset: 17vw;
  }
  .hero__stage {
    position: relative;
    height: 100svh;
    min-height: 40rem;
    overflow: clip;
  }

  .hero__field {
    position: absolute;
    inset: 0 0 0 var(--field-x);
    background:
      radial-gradient(120% 70% at 85% 0%, color-mix(in oklab, var(--cm-turquoise) 70%, var(--cm-cream)) 0%, transparent 55%),
      linear-gradient(180deg, var(--cm-turquoise) 0%, var(--cm-turquoise-deep) 100%);
  }

  /* Nombre-cartel */
  .hero__name {
    position: absolute;
    inset: 0;
    padding: var(--name-top) var(--gutter) 0;
    display: flex;
    flex-direction: column;
    pointer-events: none;
    color: var(--cm-gunmetal);
    z-index: 2;
  }
  .hero__line {
    display: block;
    overflow: clip;
    padding-top: 0.04em;
    margin-top: -0.04em;
  }
  .hero__line--offset {
    padding-left: var(--name-offset);
  }
  .hero__name--inverse {
    z-index: 4;
    color: var(--cm-cream);
    mask: url('/brand/m.svg') no-repeat;
    mask-size: var(--mw) var(--mh);
    mask-position: var(--mx) var(--my);
  }

  .hero__name--field {
    z-index: 2;
    color: var(--cm-cream);
    clip-path: inset(0 0 0 var(--field-x));
  }

  /* Ventana M */
  /*
   * La ventana ocupa todo el escenario y nunca se escala: solo crece su máscara M
   * (--ms). Así el Portal M no crea capas gigantes que parpadeen al volver.
   * El punto fijo del crecimiento está dentro de la pierna izquierda (11 %, 72 %).
   */
  .hero__window {
    --ms: 1;
    position: absolute;
    inset: 0;
    z-index: 3;
    overflow: clip;
    mask-image: url('/brand/m.svg');
    mask-repeat: no-repeat;
    mask-size: calc(var(--mw) * var(--ms)) calc(var(--mh) * var(--ms));
    mask-position:
      calc(var(--mx) + var(--mw) * 0.11 * (1 - var(--ms)))
      calc(var(--my) + var(--mh) * 0.72 * (1 - var(--ms)));
    background: linear-gradient(165deg, var(--cm-gunmetal-soft) 20%, var(--cm-gunmetal) 75%);
  }
  .hero__frame {
    position: absolute;
    left: var(--mx);
    top: var(--my);
    width: var(--mw);
    height: var(--mh);
    transform-origin: 11% 72%;
  }
  .hero__sun {
    position: absolute;
    width: 30%;
    aspect-ratio: 1;
    left: 54%;
    top: 6%;
    border-radius: 50%;
    background:
      radial-gradient(circle, rgb(29 39 48 / 0.28) 0.9px, transparent 1.3px) 0 0 / 7px 7px,
      var(--cm-orange);
    mask: linear-gradient(200deg, #000 55%, transparent 100%);
  }
  .hero__orbits {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    stroke: rgb(248 243 234 / 0.5);
    stroke-width: 1.2;
  }
  .hero__orbits circle {
    fill: var(--cm-cream);
    stroke: none;
  }

  .hero__screen {
    position: absolute;
    margin: 0;
    width: 46%;
    border-radius: var(--radius-frame);
    overflow: hidden;
    background: var(--cm-cream);
    box-shadow: 0 30px 50px -20px rgb(0 0 0 / 0.55);
  }
  .hero__screen--a {
    left: -6%;
    top: 30%;
    rotate: -4deg;
  }
  .hero__screen--b {
    left: 64%;
    top: 44%;
    width: 42%;
    rotate: 5deg;
  }
  .hero__screen--c {
    left: 18%;
    top: 74%;
    width: 38%;
    rotate: -9deg;
  }
  .hero__screen-bar {
    font-family: var(--font-mono);
    font-size: clamp(0.5rem, 0.7vw, 0.7rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.45em 0.8em;
    color: var(--cm-gunmetal);
    background: var(--cm-cream);
    border-bottom: 1px solid rgb(29 39 48 / 0.15);
  }
  .hero__veil {
    position: absolute;
    inset: 0;
    background: var(--cm-gunmetal);
    opacity: 0;
    pointer-events: none;
  }

  /* Imprenta: planchas de color en duotono */
  .print {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .print :global(img) {
    width: 100%;
    height: auto;
    filter: grayscale(1) contrast(1.15);
  }
  .print__plate {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .print__plate--a {
    background: var(--cm-orange);
    mix-blend-mode: multiply;
    opacity: 0.85;
  }
  .print__plate--b {
    background: var(--cm-turquoise-deep);
    mix-blend-mode: screen;
    opacity: 0.7;
  }

  .hero__stamp {
    position: absolute;
    z-index: 5;
    left: calc(var(--mx) - clamp(3rem, 4.5vw, 4.75rem));
    top: calc(var(--my) + var(--mh) - clamp(7rem, 10vw, 10rem));
  }

  .hero__stat {
    position: absolute;
    z-index: 5;
    right: var(--gutter);
    top: calc(var(--header-h) + 1.5rem);
    width: min(16rem, 30vw);
    display: grid;
    gap: 0.2rem;
    font-size: var(--step--1);
    line-height: 1.35;
    color: var(--cm-gunmetal);
  }
  .hero__stat strong {
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 62%;
    font-size: clamp(2.6rem, 4.4vw, 4.4rem);
    line-height: 0.85;
    text-transform: uppercase;
  }

  .hero__copy {
    position: absolute;
    z-index: 5;
    left: var(--gutter);
    bottom: max(5svh, 2.5rem);
    width: min(36vw, 36rem);
    display: grid;
    gap: var(--space-m);
  }
  .hero__title {
    font-size: var(--step-3);
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .hero__lead {
    max-width: 40ch;
    color: var(--cm-ink-soft);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-2xs);
  }

  .hero__hint {
    position: absolute;
    z-index: 5;
    right: 0.6rem;
    top: 50%;
    writing-mode: vertical-rl;
    color: var(--cm-gunmetal);
  }
  .hero__hint::before {
    display: none;
  }

  /* Pantallas medianas: el bloque de copy se acomoda */
  @media (max-width: 1180px) and (min-width: 861px) {
    .hero {
      --name-offset: 12vw;
    }
    .hero__copy {
      width: min(44vw, 30rem);
    }
  }

  /* Móvil: ventana arriba, nombre y copy debajo */
  @media (max-width: 860px) {
    .hero {
      --mw: min(88vw, 34rem);
      --mx: calc(100vw - var(--mw) - 3vw);
      --my: calc(var(--header-h) + 0.5rem);
      --name-top: calc(var(--my) + var(--mh) + 0.75rem);
      --field-x: 100vw;
      --name-offset: 14vw;
    }
    .hero__stage {
      height: auto;
      min-height: 100svh;
      padding-bottom: var(--space-l);
    }
    .hero__field {
      width: 100%;
      height: calc(var(--my) + var(--mh) * 0.62);
      inset: 0 0 auto 0;
    }
    .hero__name {
      font-size: 22vw;
    }
    .hero__copy {
      position: relative;
      left: auto;
      bottom: auto;
      width: auto;
      padding: calc(var(--my) + var(--mh) + 0.75rem + 22vw * 1.7 + 1.75rem) var(--gutter) 0;
    }
    .hero__stat,
    .hero__hint {
      display: none;
    }
    .hero__stamp {
      left: auto;
      right: calc(var(--gutter) * 0.5);
      top: calc(var(--my) + var(--mh) * 0.42);
    }
    .hero__stamp :global(.stamp) {
      --stamp-size: 5.5rem !important;
    }
  }
</style>
