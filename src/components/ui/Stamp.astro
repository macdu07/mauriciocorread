---
import Icon from './Icon.astro';

interface Props {
  text: string;
  size?: string;
  tone?: 'ink' | 'cream' | 'orange';
  class?: string;
}
const { text, size = '9rem', tone = 'ink', class: className } = Astro.props;
const id = `stamp-${Math.random().toString(36).slice(2, 8)}`;
---

<div class:list={['stamp', `stamp--${tone}`, className]} style={`--stamp-size:${size}`} data-stamp aria-hidden="true">
  <svg viewBox="0 0 200 200" class="stamp__ring" data-stamp-ring>
    <defs>
      <path id={id} d="M100,100 m-74,0 a74,74 0 1,1 148,0 a74,74 0 1,1 -148,0" />
    </defs>
    <circle cx="100" cy="100" r="96" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <circle cx="100" cy="100" r="54" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <text>
      <textPath href={`#${id}`} textLength="462">{text.toUpperCase()}</textPath>
    </text>
  </svg>
  <span class="stamp__core"><Icon name="star" size="34%" /></span>
</div>

<style>
  .stamp {
    position: relative;
    width: var(--stamp-size);
    aspect-ratio: 1;
    border-radius: 50%;
    color: var(--cm-gunmetal);
    background: var(--cm-cream);
  }
  .stamp--cream {
    color: var(--cm-cream);
    background: transparent;
  }
  .stamp--orange {
    color: var(--cm-gunmetal);
    background: var(--cm-orange);
  }
  .stamp__ring {
    width: 100%;
    height: 100%;
    will-change: transform;
  }
  .stamp__ring text {
    font-family: var(--font-mono);
    font-size: 15.5px;
    font-weight: 500;
    letter-spacing: 0.04em;
    fill: currentColor;
  }
  .stamp__core {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--cm-orange);
  }
  .stamp--orange .stamp__core {
    color: var(--cm-gunmetal);
  }
</style>
