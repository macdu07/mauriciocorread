---
import Icon from './Icon.astro';

interface Props {
  href: string;
  variant?: 'ink' | 'orange' | 'cream' | 'line';
  icon?: 'arrow-up-right' | 'arrow-down-right' | 'arrow-down';
  external?: boolean;
  cursor?: string;
  class?: string;
}
const { href, variant = 'ink', icon = 'arrow-up-right', external = false, cursor, class: className } = Astro.props;
---

<a
  href={href}
  class:list={['btn', `btn--${variant}`, className]}
  data-magnetic
  data-cursor={cursor}
  {...(external ? { target: '_blank', rel: 'noopener' } : {})}
>
  <span class="btn__label" data-text-roll><span><slot /></span></span>
  <span class="btn__icon"><Icon name={icon} size="1.1em" /></span>
  {external && <span class="visually-hidden"> (abre en otra pestaña)</span>}
</a>

<style>
  .btn {
    --btn-bg: var(--cm-gunmetal);
    --btn-fg: var(--cm-cream);
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    min-height: 3.25rem;
    padding: 0 1.15rem 0 1.4rem;
    border-radius: var(--radius-s);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-weight: 600;
    font-size: var(--step-0);
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--dur-s) var(--ease-soft),
      color var(--dur-s) var(--ease-soft),
      box-shadow var(--dur-s) var(--ease-soft);
    will-change: transform;
  }
  .btn--orange {
    --btn-bg: var(--cm-orange);
    --btn-fg: var(--cm-gunmetal);
  }
  .btn--cream {
    --btn-bg: var(--cm-cream);
    --btn-fg: var(--cm-gunmetal);
  }
  .btn--line {
    --btn-bg: transparent;
    --btn-fg: currentColor;
    box-shadow: inset 0 0 0 1.5px currentColor;
  }
  .btn__label {
    position: relative;
    display: inline-block;
    overflow: hidden;
    line-height: 1.2;
  }
  .btn__label > span {
    display: block;
    transition: transform var(--dur-s) var(--ease-out);
  }
  .btn__label > span::after {
    content: attr(data-label);
    position: absolute;
    left: 0;
    top: 100%;
  }
  .btn__icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-s);
    background: color-mix(in oklab, var(--btn-fg) 12%, transparent);
    transition: transform var(--dur-s) var(--ease-out);
  }
  @media (hover: hover) {
    .btn:hover .btn__label > span {
      transform: translateY(-100%);
    }
    .btn:hover .btn__icon {
      transform: rotate(45deg);
    }
    .btn--ink:hover {
      --btn-bg: var(--cm-gunmetal-soft);
    }
    .btn--orange:hover,
    .btn--cream:hover {
      box-shadow: 0 10px 24px -12px rgb(29 39 48 / 0.55);
    }
  }
  .btn:active {
    transform: scale(0.98);
  }
</style>

<script>
  // Duplica la etiqueta para el efecto de rodillo al pasar el cursor.
  document.querySelectorAll<HTMLElement>('[data-text-roll] > span').forEach((el) => {
    el.dataset.label = el.textContent?.trim() ?? '';
  });
</script>
