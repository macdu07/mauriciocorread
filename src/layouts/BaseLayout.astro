---
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Preloader from '../components/layout/Preloader.astro';
import Cursor from '../components/ui/Cursor.astro';
import { getSettings, toLocale } from '../i18n';
import type { ShareImage } from '../lib/share-image';

interface Props {
  title: string;
  description: string;
  preloader?: { edition: string };
  alternate?: { es: string; en: string };
  /** La portada de la página es oscura: el encabezado arranca en crema. */
  headerOnDark?: boolean;
  /** Páginas fuera del índice (404): sin canonical ni hreflang. */
  noindex?: boolean;
  /** Datos estructurados schema.org (ver src/lib/jsonld.ts). */
  jsonLd?: Record<string, unknown>;
  /** Imagen para compartir (ver src/lib/share-image.ts). */
  image?: ShareImage;
}
const { title, description, preloader, alternate = { es: '/', en: '/en/' }, headerOnDark = false, noindex = false, jsonLd, image: pageImage } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const settings = await getSettings(locale);
// Sin imagen propia: la tarjeta de marca del idioma (generada con `pnpm og`).
const image: ShareImage = pageImage ?? { src: `/og/${locale}.png`, width: 1200, height: 630, alt: `${settings.siteName} — ${settings.role}` };
const canonical = new URL(Astro.url.pathname, Astro.site);
const homeHref = locale === 'en' ? '/en/' : '/';
const langHref = locale === 'en' ? alternate.es : alternate.en;
---

<!doctype html>
<html lang={locale} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="es" href={new URL(alternate.es, Astro.site)} />
        <link rel="alternate" hreflang="en" href={new URL(alternate.en, Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL(alternate.es, Astro.site)} />
      </>
    )}
    <meta name="theme-color" content="#1D2730" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/Archivo-900-wdth62-100-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Geist-Variable-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'es_CO'} />
    <meta property="og:locale:alternate" content={locale === 'en' ? 'es_CO' : 'en_US'} />
    <meta property="og:site_name" content={settings.siteName} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL(image.src, Astro.site)} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
    <script is:inline data-preloader={preloader ? "1" : "0"}>
      // Preloader solo en la primera visita de la sesión y con movimiento permitido.
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        d.classList.add('js');
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var seen = false;
        try { seen = sessionStorage.getItem('mc-seen') === '1'; } catch (e) {}
        if (!reduce) {
          d.classList.add('motion-pending');
          setTimeout(function () { d.classList.remove('motion-pending'); }, 3500);
        }
        // Una transición entre páginas omitida (recarga, pestaña oculta) no es un error.
        var quiet = function (e) { if (e.viewTransition) e.viewTransition.finished.catch(function () {}); };
        window.addEventListener('pagereveal', quiet);
        window.addEventListener('pageswap', quiet);
        if (!reduce && !seen && document.currentScript && document.currentScript.dataset.preloader === '1') {
          d.classList.add('is-loading');
          // Respaldo: si el motor no llega a arrancar el preloader, no tapa la página para siempre.
          setTimeout(function () { if (!d.dataset.motionBoot) d.classList.remove('is-loading'); }, 4000);
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">{settings.skipLink}</a>
    {preloader && <Preloader edition={preloader.edition} name={settings.siteName} />}
    <Header settings={settings} homeHref={homeHref} langHref={langHref} onDark={headerOnDark} />
    <main id="contenido">
      <slot />
    </main>
    <Footer settings={settings} langHref={langHref} />
    <Cursor />
    <script>
      import { boot } from '../scripts/motion/main';
      boot();
    </script>
  </body>
</html>
